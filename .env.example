[TEMPLATE]
# ZHcode environment variables — copy to .env and fill in real values.
# NEVER commit .env; it is git-ignored.

# ── Phase 2: Model Gateway ──────────────────────────────────────────────

# Provider selection: "mock" (default, no API key needed), "openrouter", or "deepseek"
ZHCODE_PROVIDER=mock

# Model override (optional — provider default is used if not set)
# Examples: "deepseek-chat", "deepseek/deepseek-chat", "anthropic/claude-3-haiku"
# ZHCODE_MODEL=

# OpenRouter (https://openrouter.ai) — gateway to DeepSeek, Gemini, Claude, GPT, ...
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# DeepSeek (https://platform.deepseek.com) — low-cost production LLM
# Get your key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Future provider keys (Phase 3+) ─────────────────────────────────────
# GEMINI_API_KEY=
# KIMI_API_KEY=
# NVIDIA_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────
# ZHCODE_LOG_LEVEL=info
