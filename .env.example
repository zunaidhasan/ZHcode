[TEMPLATE]
# ZHcode environment variables — copy to .env and fill in real values.
# NEVER commit .env; it is git-ignored.

# ── Phase 2: Model Gateway ──────────────────────────────────────────────

# Provider selection: "mock" (default, no API key needed) or "openrouter"
ZHCODE_PROVIDER=mock

# Model override (optional — provider default is used if not set)
# Examples: "deepseek/deepseek-chat", "anthropic/claude-3-haiku"
# ZHCODE_MODEL=

# OpenRouter (https://openrouter.ai)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Future provider keys (Phase 3+) ─────────────────────────────────────
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# KIMI_API_KEY=
# NVIDIA_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────
# ZHCODE_LOG_LEVEL=info
